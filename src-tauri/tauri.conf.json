{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortexDL",
  "version": "../package.json",
  "identifier": "app.vortexdl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "极涌 VortexDL",
        "width": 1180,
        "height": 710,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"]
  }
}
